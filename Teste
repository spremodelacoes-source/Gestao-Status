# Ligação à Base de Dados (Neon / PostgreSQL via Variável de Ambiente)
DATABASE_URL = os.environ.get("DATABASE_URL")

def test_connection():
    if not DATABASE_URL:
        st.warning("⚠️ URL da Base de Dados ainda não configurada nas Variáveis do Render.")
        return False
    try:
        conn = psycopg2.connect(DATABASE_URL)
        conn.close()
        return True
    except Exception as e:
        st.error(f"Erro na ligação: {e}")
        return False

# Painel Principal
